config_version=5

[application]

config/name="Slime Land Farm"
config/features=PackedStringArray("4.7")
run/main_scene="res://scenes/world/main.tscn"

[autoload]

GameClock="*res://scripts/managers/game_clock.gd"
WeatherManager="*res://scripts/managers/weather_manager.gd"
CalendarEvents="*res://scripts/managers/calendar_event_manager.gd"
SlimeDiscovery="*res://scripts/managers/slime_discovery_manager.gd"
Economy="*res://scripts/managers/economy_manager.gd"
SaveManager="*res://scripts/managers/save_manager.gd"
Sfx="*res://scripts/managers/basic_sfx_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.12, 0.19, 0.13, 1)
